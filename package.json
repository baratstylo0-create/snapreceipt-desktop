{
  "name": "snapreceipt-desktop",
  "version": "1.0.0",
  "description": "SnapReceipt AI desktop app — thin Electron wrapper around the live web app.",
  "main": "main.js",
  "author": "SnapReceipt AI",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "node build-icon.js",
    "build:win": "npm run build:win:release",
    "build:win:qa": "electron-builder --win -c.forceCodeSigning=false -c.win.signExecutable=false",
    "build:win:release": "node scripts/assert-windows-signing-env.js && electron-builder --win -c.forceCodeSigning=true && powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& '.\\scripts\\verify-windows-release.ps1'\"",
    "verify:windows-release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& '.\\scripts\\verify-windows-release.ps1'\"",
    "prepare:win:store": "node scripts/prepare-store-build-config.js",
    "build:win:store:qa": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".\\scripts\\build-windows-store.ps1\" -Qa",
    "build:win:store": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".\\scripts\\build-windows-store.ps1\"",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.2"
  },
  "build": {
    "appId": "com.snapreceiptai.desktop",
    "productName": "SnapReceipt AI",
    "asar": true,
    "publish": null,
    "files": [
      "main.js",
      "config.js",
      "google-auth.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SnapReceipt-Setup.exe",
      "signAndEditExecutable": true,
      "signExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "https://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SnapReceipt AI"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "SnapReceipt-Mac.dmg",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "title": "SnapReceipt AI"
    }
  }
}
